library(ggplot2)
library(ggpubr)
library(tidyr)
library(dplyr)
library(reshape2)
library(tidyverse)
setwd("~/Desktop/KROH/data/rab")
rab <- read.table("results.txt",
header = FALSE,
col.names=c("NEUTRAL","MUT","RAB",
"RAB_NEU","AVG","Q25","Q975","N_SITES"))
ggsave("figure2.png", plot=rab_plot,
path ="~/Desktop/KROH/figures/final_figures/",
width = 5, height = 4.5, units = "in", dpi = 300)
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
library(ggpubr)
library(tidyr)
library(dplyr)
library(reshape2)
library(tidyverse)
setwd("~/Desktop/KROH/data/rab")
rab <- read.table("results.txt",
header = FALSE,
col.names=c("NEUTRAL","MUT","RAB",
"RAB_NEU","AVG","Q25","Q975","N_SITES"))
rab$MUT <- str_replace_all(rab$MUT, "4fold_synonymous", "FOURFOLD")
rab$MUT <- str_replace_all(rab$MUT, "noncoding", "UTR")
rab$MUT <- str_replace_all(rab$MUT, "deleterious", "DEL")
rab$MUT <- str_replace_all(rab$MUT, "tolerated", "TOL")
rab$MUT <- str_replace_all(rab$MUT, "nonsynonymous", "NONSYN")
rab$MUT <- str_replace_all(rab$MUT, "synonymous", "SYN")
rab$MUT <- str_replace_all(rab$MUT, "lossoffunction", "LOF")
rab$MUT <- str_replace_all(rab$MUT, "intergenic", "INTER")
rab$MUT <- factor(rab$MUT, levels = c("INTER", "FOURFOLD","UTR",
"SYN", "TOL",
"NONSYN", "DEL",
"LOF"))
#Subset by Neutral Sites
fourfold_rab <- (rab %>% filter(NEUTRAL=="4fold_synonymous"))[c(1:7),]
intergenic_rab <- (rab %>% filter(NEUTRAL=="intergenic"))[c(1:6,8),]
rab_plot <-
ggplot(intergenic_rab, aes(x = log(RAB), y = MUT)) +
geom_bar(stat="identity", fill="#F7F7F7", color="black") +
geom_errorbarh(aes(xmin = log(Q25), xmax = log(Q975)), height = 0.2) +
geom_text(aes(label = N_SITES),
x = -2, hjust = 0, size = 3) +
scale_x_continuous(limits = c(-2,2), breaks = seq(-2,2,0.5)) +
geom_vline(xintercept = 0, color="black") +
annotate("text", x = -Inf, y = Inf, label = "cKIWA Excess",
hjust = -0.1, vjust = 1.2, size = 2.5) +
annotate("text", x = Inf, y = Inf, label = "cKIWA Deficit",
hjust = 1.1, vjust = 1.2, size = 2.5) +
coord_cartesian(clip = "off") +
theme(
plot.margin = margin(t = 10, r = 25, b = 10, l = 25),
panel.background = element_blank(),
panel.grid.minor.x = element_line(linetype="dashed", color="black", linewidth=.05),
panel.border = element_rect(color="black", fill=NA),
axis.title.y = element_blank(),
axis.text.x = element_text(size=8, color="black"),
axis.text.y = element_text(size=8, color="black"),
text = element_text(size = 8),
legend.position = "bottom"
) +
xlab("ln(RAB)")
rab_plot
ggsave("figure2.png", plot=rab_plot,
path ="~/Desktop/KROH/figures/final_figures/",
width = 5, height = 4.5, units = "in", dpi = 300)
